{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SDC Converter: GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/sdc_converter_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "pythonArgs": ["-B", "-X", "utf8"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "SDC Converter: 配布ZIPを作成",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build_portable.py",
            "python": "${workspaceFolder}/.venv-build/Scripts/python.exe",
            "pythonArgs": ["-B", "-X", "utf8"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        }
    ]
}
